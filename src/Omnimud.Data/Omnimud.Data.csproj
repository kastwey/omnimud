<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Omnimud.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Lua scripts of the built-in message rule sets (see Seed/BuiltInMessageRuleSets.cs). -->
    <EmbeddedResource Include="Seed\MessageRuleScripts\*.lua" LogicalName="Omnimud.Data.Seed.MessageRuleScripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omnimud.Core\Omnimud.Core.csproj" />
  </ItemGroup>

</Project>
