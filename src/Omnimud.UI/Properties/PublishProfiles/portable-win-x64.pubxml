<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable build: one self-contained Omnimud.exe (no .NET install needed) plus the folders that
  must stay as loose files next to it:
    dlls\    screen reader libraries (loaded by path, per architecture)
    sounds\  client sound effects
    data\    created on first run: database, logs, downloaded sounds. Copy the whole folder to move Omnimud.

  dotnet publish src\Omnimud.UI -p:PublishProfile=portable-win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLite and audio ship native libraries: bundle them inside the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinForms and the Lua engine rely on reflection: trimming is not safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
